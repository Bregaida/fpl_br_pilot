# Configuração de finais de linha
* text=auto eol=lf

# Scripts Windows mantêm CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Arquivos específicos
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binários
*.jar binary
*.war binary
*.ear binary
*.class binary
*.so binary
*.dll binary
*.exe binary
*.zip binary
*.tar.gz binary
*.rar binary
*.7z binary